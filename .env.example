# =============================================================================
# SMART CREDIT SYSTEM: CONFIGURATION ENVIRONMENT VARIABLES
# Copy this file to .env and adjust variables as needed.
# =============================================================================

# Path to PostgreSQL 16 canonical schema.sql (defaults to repo root schema.sql)
SCHEMA_PATH=schema.sql

# Google Gemini API key (optional; if omitted, intelligent local heuristic matcher is used)
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Target Database Connection URL (e.g. postgresql://user:password@localhost:5432/smart_credit)
# If omitted or in-memory, changes are validated without persistent write
DATABASE_URL=

# Web Wizard Server settings
HOST=127.0.0.1
PORT=8000

# Temporary upload storage directory
TEMP_UPLOAD_DIR=smart_credit_uploads
