# Настройки приложения
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production

# Подключение к PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graeae_eye_db

# Интеграция с AI (Модуль 1: AI-парсер, Модуль 4: LLM Synthesis)
# По умолчанию: LLM_PROVIDER=auto, OLLAMA_HOST пустой (запускается надежный не-ИИ сборщик отчетов).
# Чтобы включить локальную нейросеть (Ollama), просто запустите: ./setup_ollama.sh
OPENAI_API_KEY=
LLM_MODEL=llama3.2:1b
OLLAMA_HOST=
LLM_PROVIDER=auto
LLM_INFERENCE_TIMEOUT=300.0
LLM_HEARTBEAT_INTERVAL=10.0

# Automated Backup & Restore Configuration
BACKUP_INTERVAL_SECONDS=300
BACKUP_DIR=src/fintech_app/db/backups
AUTO_RESTORE_LAST_DB_BACKUP=false
FORCE_RESTORE=false
